{
  "name": "kaldirim",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "balance": "vitest run tests/campaign.test.ts",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames && node scripts/postbuild.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.7",
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
